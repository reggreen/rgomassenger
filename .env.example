# Appwrite Backend Configuration (Optional - Client side fallback works out-of-the-box if omitted)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=rg_database
NEXT_PUBLIC_APPWRITE_BUCKET_ID=rg_storage

# Supabase Configuration (Optional - Backup option)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Web Push Notification VAPID Keys for Background Messenger Service
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
